ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Only needed for a Vercel deployment — leave empty for local/CLI use.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN come from the Upstash
# Redis marketplace integration on your Vercel project (adds them
# automatically). CRON_SECRET is one you set yourself in Vercel's project
# env vars — Vercel Cron then sends it as "Authorization: Bearer <value>"
# on every scheduled call to /refresh, which is how that endpoint tells a
# legitimate cron trigger apart from a random visitor.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
